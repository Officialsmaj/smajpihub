{
    "extends":  "expo/tsconfig.base",
    "compilerOptions":  {
                            "strict":  true,
                            "types":  ["node"],
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*"
                                                  ],
                                          "@/assets/*":  [
                                                             "./assets/*"
                                                         ]
                                      },
                            "allowImportingTsExtensions":  true
                        },
    "include":  [
                    "**/*.ts",
                    "**/*.tsx",
                    ".expo/types/**/*.ts",
                    "expo-env.d.ts"
                ]
}
